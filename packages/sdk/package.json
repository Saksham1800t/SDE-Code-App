{
  "name": "@sde-code/sdk",
  "version": "1.0.0",
  "description": "Developer SDK package for building SDE Code IDE Extensions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sde-sdk": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"fs.mkdirSync('bin', {recursive:true}); fs.writeFileSync('bin/cli.js', '#!/usr/bin/env node\\nrequire(\\'../dist/cli.js\\')'); fs.chmodSync('bin/cli.js', 0755);\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3"
  }
}
